# Copy to .env and fill in as you enable features.

# --- Checkpointer ---
# Leave DATABASE_URL empty to use local SQLite (backend/checkpoints.sqlite).
# Set it to your Supabase Postgres connection string to use durable Postgres checkpoints.
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Step 3: Gemini multimodal ingestion (optional) ---
# Leave GOOGLE_API_KEY empty to use the deterministic stub extractor.
# Set it (free key from https://aistudio.google.com/apikey) to parse real
# drawings / tech-packs / PDFs with Gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
